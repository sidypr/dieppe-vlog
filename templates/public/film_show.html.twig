{% extends 'base.html.twig' %}

{% block title %}{{ film.title }} - DieppeVlog{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('home') }}">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ film.title }}</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            {# Lecteur vidéo #}
            {% if film.videoUrl starts with '/uploads/videos/' %}
                <div class="ratio ratio-16x9 mb-4">
                    <video class="rounded shadow" controls preload="metadata">
                        <source src="{{ asset(film.videoUrl) }}" type="video/mp4">
                        <source src="{{ asset(film.videoUrl) }}" type="video/webm">
                        <source src="{{ asset(film.videoUrl) }}" type="video/ogg">
                        Votre navigateur ne supporte pas la lecture de vidéos.
                    </video>
                </div>
            {% elseif film.videoUrl %}
                <div class="ratio ratio-16x9 mb-4">
                    <iframe src="{{ film.videoUrl }}" 
                            allowfullscreen 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            class="rounded shadow">
                    </iframe>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> Aucune vidéo n'est disponible pour ce film.
                </div>
            {% endif %}

            {# Informations du film #}
            <div class="card mb-4">
                <div class="card-body">
                    <h1 class="h2 mb-3">{{ film.title }}</h1>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge bg-{{ film.isActive ? 'success' : 'danger' }}">
                                {{ film.isActive ? 'Disponible' : 'Non disponible' }}
                            </span>
                            <small class="text-muted ms-2">
                                <i class="far fa-calendar-alt"></i> 
                                Ajouté le {{ film.createdAt|date('d/m/Y') }}
                            </small>
                        </div>
                        {% if is_granted('ROLE_USER') %}
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary btn-sm" id="shareButton"
                                        onclick="navigator.clipboard.writeText(window.location.href).then(() => this.innerHTML = '<i class=\'fas fa-check\'></i> Copié !')">
                                    <i class="fas fa-share-alt"></i> Partager
                                </button>
                                <a href="{{ path('film_like', {'id': film.id}) }}" 
                                   class="btn btn-sm {% if app.user in film.likedBy %}btn-danger{% else %}btn-outline-danger{% endif %}">
                                    <i class="{% if app.user in film.likedBy %}fas{% else %}far{% endif %} fa-heart"></i>
                                    <span class="ms-1">{{ film.likedBy|length }}</span>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                    <p class="card-text">{{ film.description|nl2br }}</p>
                </div>
            </div>

            {# Section commentaires #}
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0">Commentaires</h3>
                    <span class="badge bg-primary">{{ film.comments|length }}</span>
                </div>
                <div class="card-body">
                    {% if is_granted('ROLE_USER') %}
                        <form action="{{ path('film_comment', {'id': film.id}) }}" method="post" class="mb-4">
                            <div class="form-group">
                                <textarea name="content" class="form-control" rows="3" 
                                          placeholder="Laissez votre commentaire..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-2">
                                <i class="fas fa-paper-plane"></i> Commenter
                            </button>
                        </form>
                        <hr>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> 
                            <a href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un commentaire.
                        </div>
                    {% endif %}

                    <div class="comments-list">
                        {% for comment in film.comments|sort((a, b) => b.createdAt <=> a.createdAt) %}
                            <div class="card mb-3 border-0 bg-light">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <i class="fas fa-user-circle"></i>
                                            <span class="fw-bold">{{ comment.user.email }}</span>
                                        </div>
                                        <small class="text-muted">
                                            <i class="far fa-clock"></i> 
                                            {{ comment.createdAt|date('d/m/Y H:i') }}
                                        </small>
                                    </div>
                                    <p class="card-text mb-0">{{ comment.content|nl2br }}</p>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-center text-muted">
                                <i class="far fa-comments fa-2x mb-2"></i><br>
                                Aucun commentaire pour le moment.<br>
                                {% if is_granted('ROLE_USER') %}
                                    Soyez le premier à commenter !
                                {% endif %}
                            </p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# Sidebar #}
        <div class="col-lg-4">
            {# Statistiques #}
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="h5 mb-0">Statistiques</h4>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="far fa-heart"></i>
                            {{ film.likedBy|length }} j'aime
                        </li>
                        <li class="mb-2">
                            <i class="far fa-comments"></i>
                            {{ film.comments|length }} commentaires
                        </li>
                        <li>
                            <i class="far fa-eye"></i>
                            En ligne depuis {{ film.createdAt|date('d/m/Y') }}
                        </li>
                    </ul>
                </div>
            </div>

            {# Films similaires #}
            <div class="card">
                <div class="card-header">
                    <h4 class="h5 mb-0">Films similaires</h4>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        {% for similarFilm in similar_films|default([]) %}
                            <a href="{{ path('film_show', {'id': similarFilm.id}) }}" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                {{ similarFilm.title }}
                                <span class="badge bg-primary rounded-pill">
                                    {{ similarFilm.likedBy|length }}
                                    <i class="far fa-heart ms-1"></i>
                                </span>
                            </a>
                        {% else %}
                            <div class="p-3 text-center text-muted">
                                Aucun film similaire disponible
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion du bouton de partage
    const shareButton = document.getElementById('shareButton');
    if (shareButton) {
        shareButton.addEventListener('click', function() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                this.innerHTML = '<i class="fas fa-check"></i> Copié !';
                setTimeout(() => {
                    this.innerHTML = '<i class="fas fa-share-alt"></i> Partager';
                }, 2000);
            });
        });
    }

    // Gestion du lecteur vidéo
    const videoPlayer = document.querySelector('video');
    if (videoPlayer) {
        // Sauvegarder la position de lecture
        videoPlayer.addEventListener('timeupdate', function() {
            localStorage.setItem('videoPosition_' + {{ film.id }}, this.currentTime);
        });

        // Restaurer la position de lecture
        const savedPosition = localStorage.getItem('videoPosition_' + {{ film.id }});
        if (savedPosition) {
            videoPlayer.currentTime = parseFloat(savedPosition);
        }

        // Gestion du plein écran
        videoPlayer.addEventListener('dblclick', function() {
            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else {
                this.requestFullscreen();
            }
        });
    }
});
</script>
{% endblock %}
{% endblock %} 