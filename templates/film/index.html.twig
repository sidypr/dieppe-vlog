{% extends 'base.html.twig' %}

{% block title %}Liste des Films{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Films disponibles</h1>
    
    <div class="row mt-4">
        {% for film in films %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ film.title }}</h5>
                        <p class="card-text">{{ film.description|slice(0, 100) }}...</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="{{ path('film_show', {'id': film.id}) }}" class="btn btn-primary">Regarder</a>
                            <small class="text-muted">
                                {{ film.likedBy|length }} likes
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p>Aucun film disponible pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %} 