{% extends 'admin/base.html.twig' %}

{% block content %}
<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">{{ title }}</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">{{ title }}</h6>
        </div>
        <div class="card-body">
            {% if form.videoUrl is defined %}
                <div class="alert alert-info">
                    <h5>Comment ajouter une vidéo ?</h5>
                    <p>Vous pouvez ajouter :</p>
                    <ul>
                        <li>Une URL YouTube (ex: https://www.youtube.com/watch?v=XXXX)</li>
                        <li>Une URL Vimeo (ex: https://vimeo.com/XXXX)</li>
                        <li>Une URL d'embed directe</li>
                    </ul>
                    <p>Le système convertira automatiquement l'URL en format embed.</p>
                </div>
            {% endif %}

            {{ form_start(form) }}
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.title) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.isActive) }}
                </div>
            </div>

            {{ form_row(form.description) }}
            
            {% if form.videoUrl is defined %}
                {{ form_row(form.videoUrl) }}
            {% endif %}

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Enregistrer
                </button>
                <a href="{{ path('admin_films') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %} 